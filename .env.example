# HackEasy Environment Configuration
# AI Provider (Hack Club AI proxy – free, no billing required)
AI_API_BASE=https://ai.hackclub.com/v1
AI_API_KEY=

# Model Fallback Chain (in order of preference)
AI_MODEL_FALLBACKS=["claude-3.5-sonnet","gemini-1.5-pro","gpt-4o-mini","mistral-nemo","deepseek-coder-v2","llama-3-8b"]

# GitHub Token (for auto-creating repos)
GITHUB_TOKEN=

# Vercel Token (for auto-deploying)
VERCEL_TOKEN=

# Optional: Namecheap API (for 1-click domain registration)
NAMECHEAP_API_KEY=
NAMECHEAP_API_USER=

# Optional: Twitter/LinkedIn API (for social media hype generator)
TWITTER_API_KEY=
LINKEDIN_API_KEY=

# Cache Settings
CACHE_ENABLED=true
CACHE_DIR=.hackeasy_cache

# Video Generation
VIDEO_MODE=auto
