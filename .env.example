# HackEasy Environment Configuration
# AI Provider (Hack Club AI proxy)
AI_API_BASE=https://ai.hackclub.com/proxy/v1
AI_API_KEY=sk-hc-v1-your-key-here

# Model Fallback Chain (in order of preference)
AI_MODEL_FALLBACKS=["openai/gpt-4o-mini","mistralai/mistral-nemo","meta-llama/llama-3.1-8b-instruct","qwen/qwen-2.5-7b-instruct"]

# GitHub Token (for auto-creating repos)
GITHUB_TOKEN=

# Vercel Token (for auto-deploying)
VERCEL_TOKEN=

# Optional: Namecheap API (for 1-click domain registration)
NAMECHEAP_API_KEY=
NAMECHEAP_API_USER=

# Optional: Twitter/LinkedIn API (for social media hype generator)
TWITTER_API_KEY=
LINKEDIN_API_KEY=

# Cache Settings
CACHE_ENABLED=true
CACHE_DIR=.hackeasy_cache

# Video Generation
VIDEO_MODE=auto
